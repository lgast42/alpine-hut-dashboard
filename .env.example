# Copy to .env and insert a Mapbox public token.
# The token is baked into the build by Vite and is therefore readable by anyone
# visiting the site. That is the intended model for public tokens. Protection
# comes from the token settings in the Mapbox account, not from this file:
# restrict it to the deployment URL and localhost, and grant only
# styles:read, fonts:read and tiles:read.
VITE_MAPBOX_TOKEN=
